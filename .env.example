# These are NOT read from this file on Vercel. Set them in the
# dashboard instead: Project → Settings → Environment Variables.
# This file only documents what to set, and is used if you run
# `vercel dev` locally with a matching ".env.local".
#
# The site itself needs none of these to work — the IMC calculator is
# plain client-side math. They're only for the optional lead webhook
# and the optional AI image generation script.

# Optional: where /api/lead forwards each contact-form submission
# (a Zapier/Make webhook, a Google Sheets Apps Script endpoint, etc).
# Without this, leads only show up in Vercel's function logs.
LEADS_WEBHOOK_URL=

# Only needed if you run scripts/generate-ai-images.js to replace the
# stock photos with bespoke AI images. Not used by the deployed site.
OPENAI_API_KEY=
